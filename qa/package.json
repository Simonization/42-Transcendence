{
  "name": "esportendence-qa",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end QA harness: boots the built backend and SPA locally and drives them over HTTP, sockets and a headless browser.",
  "scripts": {
    "stack": "node stack.js",
    "test": "node run.js",
    "test:api": "node run.js --no-ui",
    "test:migration": "node run.js --migration",
    "browser": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "1.56.1",
    "socket.io-client": "^4.8.3"
  }
}
