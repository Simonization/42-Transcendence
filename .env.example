# Database Configuration
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_TYPE=
# true: TypeORM rebuilds the schema from the entities on boot (local dev only, never production)
DB_SYNCHRONIZE=
# Apply pending migrations on boot (true/false). Unset: on exactly when DB_SYNCHRONIZE is not
# true, so production migrates itself. See docs/migrations.md.
DB_MIGRATIONS_RUN=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION=

# Application Configuration
NODE_ENV=
PORT=
# Express "trust proxy" (whose X-Forwarded-For to believe). Unset: proxies on loopback and private
# networks, which fits Caddy in front of the container. The anonymous routes are rate-limited per IP:
# if every visitor shares one bucket, req.ip is the proxy's, so set the number of proxy hops (e.g. 1).
TRUST_PROXY=

# Mail Configuration - Gmail SMTP
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Frontend URL: where the browser is sent after a Google sign-in (/login-success, /verify-2fa)
# and the base of the email verification links. Public origin, no trailing slash. Required.
#   production: FRONTEND_URL=https://<host>
FRONTEND_URL=
BACKEND_URL=
# Optional: public origin used in link-preview tags (og:image, og:url). Falls back to the request
# host (the proxy's X-Forwarded-Host / -Proto, see TRUST_PROXY). Set it when that is not the public one.
#   production: PUBLIC_BASE_URL=https://<host>
PUBLIC_BASE_URL=

# OAUTH 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google sends the user back; must match, character for character, an "Authorised redirect
# URI" of the OAuth client in Google Cloud. If unset it defaults to the LOCAL dev stack
# (https://localhost:8443/api/auth/google/callback), so production must set it:
#   production: GOOGLE_CALLBACK_URL=https://<host>/api/auth/google/callback
GOOGLE_CALLBACK_URL=

ADMIN_BOOTSTRAP_SECRET=
