# Database Configuration
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_TYPE=
# true: TypeORM rebuilds the schema from the entities on boot (local dev only, never production)
DB_SYNCHRONIZE=
# Apply pending migrations on boot (true/false). Unset: on exactly when DB_SYNCHRONIZE is not
# true, so production migrates itself. See docs/migrations.md.
DB_MIGRATIONS_RUN=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION=

# Application Configuration
NODE_ENV=
PORT=

# Mail Configuration - Gmail SMTP
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Frontend URL (for email verification links)
FRONTEND_URL=
BACKEND_URL=
# Optional: public origin used in link-preview tags (og:image, og:url). Falls back to the request host.
PUBLIC_BASE_URL=

# OAUTH 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ADMIN_BOOTSTRAP_SECRET=
